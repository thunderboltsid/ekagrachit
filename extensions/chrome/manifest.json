{
  "manifest_version": 3,
  "name": "Ekagrachit",
  "short_name": "Ekagrachit",
  "description": "Helps the Ekagrachit Mac app keep one web page in focus: off-target links never load.",
  "version": "0.1.3",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "tabs",
    "webNavigation",
    "declarativeNetRequest",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ekagrachit: open the menu-bar app",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
